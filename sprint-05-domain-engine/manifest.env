# Declares the single base package every source and test file in this module lives under.
# Sprint 6 absorbs this package, under this exact name, as source into the Trade REST API,
# so the name says domain rather than transport and is not renamed lightly.
BASE_PACKAGE=com.etleap.trading.domain

# The six catalogue exception types the brief specifies (ETLEAPCP-1281), all extending the
# single TradingDomainException base under com.etleap.trading.domain.exception. Listed here,
# not just left to be found by reading the package, per ETLEAPCP-1281's explicit task.
# (OrderValidationException is a seventh, added type - the rule 4/5 design decision recorded
# in design/decisions.md - and is deliberately not one of the six named below.)
EXCEPTION_CLASSES=AccountNotFoundException,AccountNotActiveException,InstrumentNotFoundException,InsufficientFundsException,InsufficientHoldingsException,DuplicateOrderException
