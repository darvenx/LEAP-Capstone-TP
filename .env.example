# Enterprise Trading Platform, local environment.
#
# Copy this file to .env and fill in the values marked "replace". .env is
# git-ignored; .env.example is the committed template. Add a variable here,
# without its real value, whenever you add one to your own services.

# --- PostgreSQL ----------------------------------------------------------------
# Single shared database for the whole stack. Read by the Sprint 3 apply command
# and by the Docker Postgres container.
POSTGRES_DB=trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# Lets the apply command target a scratch database. Falls back to POSTGRES_DB
# when unset.
TARGET_DATABASE=trading

# --- Kafka (Sprint 7, not used in Sprint 4) ------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- Authentication (Sprint 6/8, not used in Sprint 4) -------------------------
# Shared HS256 signing secret for local development, 32+ characters.
JWT_SECRET=dev-only-change-me-this-secret-is-not-for-production-use

# --- Fauxnance API (Sprint 4 reads these) --------------------------------------
# Base URL of the provided market-data API. Fixed for the programme.
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1

# Your personal Fauxnance key, sent as the X-Api-Key header. Quota 2000/day/key.
# Replace it with the key issued to you. Never commit a real key, never let one
# reach the browser. Until you have one, the Sprint 4 pipeline runs offline from
# the cached fixtures.
FAUXNANCE_API_KEY=replace-with-your-fauxnance-key
